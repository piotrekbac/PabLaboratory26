@WebApi_HostAddress = http://localhost:5180

// Piotr Bacior - WSEI Kraków

GET http://localhost:5180/api/contacts
Accept: application/json

### Dodaj nową osobę (POST)
POST http://localhost:5180/api/contacts/
Content-Type: application/json

{
  "firstName": "Piotr",
  "lastName" : "Broś",
  "email": "piotr@wsei.edu.pl",
  "phone": "48 341 654 789",
  "gender": 0
}

### Edytuj osobę (podmień ID na takie z odpowiedzi powyżej)
PUT http://localhost:5180/api/contacts/022d06a3-dfac-404b-9505-6119b9f40661
Content-Type: application/json

{
  "firstName": "Krzysztof",
  "lastName" : "Kowalski"
}

### Usuń osobę
DELETE http://localhost:5180/api/contacts/WSTAW_GUID_TUTAJ

### Dodanie notatki do osoby 

POST {{WebApi_HostAddress}}/api/contacts/2fb0e55a-63db-4928-b7f8-7e44e0f7ff0a/notes
Content-Type: application/json

{
  "content": "To jest bardzo ważna notatka dotycząca tej osoby! Oto nasz test PBPB"
}

### Pobierz notatki dla tej osoby
GET {{WebApi_HostAddress}}/api/contacts/2fb0e55a-63db-4928-b7f8-7e44e0f7ff0a/notes
Accept: application/json

### Usuwanie notatki
DELETE http://localhost:5180/api/contacts/2fb0e55a-63db-4928-b7f8-7e44e0f7ff0a/notes/5d8fd591-4df2-4f55-a66d-e7aa525d7101